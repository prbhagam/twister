// TWISTER — Tests Written Individually via Seeded, Traceable Exam Randomization
//
// Two halves that must never be confused:
//   * Authoring side (Course/Exam/Question/Variation/Choice) — live, editable.
//   * Run side (GenerationRun/RunQuestion/RunVariation/RunChoice/StudentExam) — a
//     frozen deep copy taken at generation time. Grading reads ONLY the run side, so
//     editing a question after printing can never desync the key from the paper in a
//     student's hand.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  role            String   @default("INSTRUCTOR") // OWNER | INSTRUCTOR | QUESTION_EDITOR | GRADER | AUDITOR
  active          Boolean  @default(true)
  externalSubject String?  @unique // future trusted identity-provider subject
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions          Session[]
  courseMemberships CourseMembership[]
  auditEvents       AuditEvent[]       @relation("AuditActor")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// ---------------------------------------------------------------- authoring side

model Course {
  id               String    @id @default(cuid())
  name             String // "CS 1301"
  title            String? // "Introduction to Computing"
  term             String?
  // Set by the Canvas roster import; the course the roster and section list are
  // pulled from.
  canvasCourseId   String?
  // JSON array of normalized section codes withheld from every exam in this
  // course. Applied at generation time, so excluding a section never touches
  // students who already sat an exam.
  excludedSections String    @default("[]")
  createdAt        DateTime  @default(now())
  archivedAt       DateTime?
  archivedById     String?

  exams         Exam[]
  students      Student[]
  rosterImports RosterImport[]
  memberships   CourseMembership[]
  auditEvents   AuditEvent[]

  @@index([archivedAt])
}

model CourseMembership {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  role        String // optional scoped role; otherwise the user's application role applies
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, active])
}

model Exam {
  id                 String    @id @default(cuid())
  courseId           String
  title              String
  instructorSeed     String
  instructions       String? // markdown, printed on the cover page
  // Reserved for a future Canvas API integration; unused today. See `canvasCourseId`.
  canvasAssignmentId String?
  // Which student identifier seeds the randomization and gets stamped into the
  // bubble sheet's ID box: "gtId" or "username". This MUST match whatever
  // Gradescope matches its roster on, or no scanned sheet will auto-match.
  // Changing it changes every student's exam, so it is snapshotted per run.
  identityField      String    @default("gtId")
  // A practice exam skips the roster entirely: generation renders one paper per
  // variant combination (using a sample identity) instead of one per student, and
  // requires every question to carry the same number of variations so "variant A"
  // means the same thing across the whole exam.
  isPracticeExam     Boolean   @default(false)
  // Link to the instructor's Google Sheet tracking in-person session signups.
  // Saved as soon as it is pasted, even if the first sync then fails, so a
  // transient fetch error never erases what was entered. See the signup side below.
  signupSheetUrl     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lifecycle          String    @default("DRAFT") // DRAFT | READY_FOR_REVIEW | APPROVED | GENERATED | LOCKED | GRADED | ARCHIVED
  archivedAt         DateTime?
  archivedById       String?

  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions     Question[]
  runs          GenerationRun[]
  signupImports SignupImport[]
  signupBuckets SignupBucket[]
  signupRows    SignupRow[]

  @@index([courseId])
  @@index([archivedAt])
}

model Question {
  id                   String    @id @default(cuid())
  examId               String
  order                Int
  title                String? // internal label for your own navigation; never printed
  points               Float     @default(1)
  // "Select all that apply": lets a variation mark more than one choice correct.
  // Off by default so marking a second choice correct by accident still blocks
  // generation instead of silently becoming a multi-answer question.
  allowMultipleCorrect Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workflowStatus       String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | RETIRED
  statusChangedAt      DateTime  @default(now())
  statusChangedById    String?
  archivedAt           DateTime?

  exam       Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  variations Variation[]

  @@index([examId, order])
  @@index([workflowStatus, archivedAt])
}

model Variation {
  id             String @id @default(cuid())
  questionId     String
  order          Int
  label          String
  promptMarkdown String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choices  Choice[]

  @@index([questionId, order])
}

model Choice {
  id           String  @id @default(cuid())
  variationId  String
  order        Int
  textMarkdown String
  isCorrect    Boolean @default(false)
  // "None of the above" / "All of the above": held out of the shuffle and appended last.
  pinToLast    Boolean @default(false)

  variation Variation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@index([variationId, order])
}

// ------------------------------------------------------------------- roster side

model RosterImport {
  id           String    @id @default(cuid())
  courseId     String
  filename     String
  imported     Int       @default(0)
  skipped      Int       @default(0)
  skipDetail   String    @default("{}") // JSON: counts by role that were excluded
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?
  uploadedById String?

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students Student[]
}

model Student {
  id           String    @id @default(cuid())
  courseId     String
  importId     String?
  // Both identifiers are stored; which one seeds and gets stamped on the bubble
  // sheet is Exam.identityField. Either may be absent depending on the source:
  // a Canvas token without SIS permission yields no gtId, and a roster CSV
  // without a GT Account column yields no username.
  gtId         String?
  username     String?
  canvasUserId String?
  firstName    String
  lastName     String
  email        String
  sections     String    @default("[]") // JSON array of normalized section codes
  role         String    @default("Student")
  createdAt    DateTime  @default(now())
  // Set when a re-import no longer finds the student in the source roster: they
  // dropped. Never a hard delete — StudentExam cascades from Student, so deleting
  // a dropped student would erase exams they already sat and grades already
  // recorded. Dropped students are filtered out of rosters, counts, and
  // generation; a student who re-enrols has this cleared on the next import.
  droppedAt    DateTime?

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  import       RosterImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  studentExams StudentExam[]
  signupRows   SignupRow[]

  @@unique([courseId, gtId])
  @@unique([courseId, username])
  @@index([courseId, lastName])
  @@index([courseId, canvasUserId])
  @@index([courseId, droppedAt])
}

// ----------------------------------------------------------------- signup side
//
// Session sign-ups live outside TWISTER — students pick a slot in an external
// Google Sheet the instructor maintains. This side syncs that sheet in: every
// non-dropped roster student ends up pointing at exactly one SignupBucket (a
// session, an exemption reason, or "not signed up"), refreshed in place on each
// sync rather than accumulated as history. Nothing here is trusted until at
// least one SignupImport has succeeded.

// One attempt to sync Exam.signupSheetUrl. Kept as history, mirroring
// RosterImport, so a bad sync (wrong URL, sharing turned off) leaves a visible
// record instead of the dashboard silently going stale with no explanation.
model SignupImport {
  id           String   @id @default(cuid())
  examId       String
  importedAt   DateTime @default(now())
  rowCount     Int      @default(0) // rows read from the sheet, before matching
  matchedCount Int      @default(0) // rows matched to a roster Student
  // JSON: { unmatched: [{gtId,canvasUserId,name,signupSlot}], warnings: string[] }
  detail       String   @default("{}")
  // Set when the fetch/parse failed outright (bad URL, sheet not link-shared, no
  // header row); rowCount/matchedCount stay 0 and nothing downstream was touched.
  error        String?
  isActive     Boolean  @default(true)
  uploadedById String?

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, importedAt])
}

// A place a student's signup lands: one in-person session, one distinct
// exemption sentence, or the single "not signed up" bucket. Upserted by
// (examId, kind, naturalKey) so re-syncing refreshes a bucket in place instead
// of duplicating it — and so an instructor's edited label/capacity survives a
// bucket that briefly has zero students, rather than being deleted and recreated.
model SignupBucket {
  id         String    @id @default(cuid())
  examId     String
  kind       String // "session" | "exception" | "not_signed_up"
  // Idempotency key: for a session, normalized "date|HH:mm|room" (so
  // "10/27/2026" and "10/27/26" collapse to the same bucket); for an exception,
  // the sentence lowercased and whitespace-collapsed; for not_signed_up, the
  // literal string "not_signed_up" (there is only ever one per exam).
  naturalKey String
  // Verbatim sheet text: the session string, the exemption sentence, or
  // "Not signed up". Doubles, sanitized, as the ZIP folder name for sessions and
  // not_signed_up — it already carries date, time, and location.
  rawLabel   String
  sessionAt  DateTime? // parsed, session buckets only: for sorting + the Slots-tab lookup
  location   String? // parsed, session buckets only: for the Slots-tab lookup
  // Instructor-editable short name. Exception buckets only — the raw sentences
  // are too long to use as a folder name directly. Null until edited or first
  // auto-derived at sync time; the ZIP export falls back to rawLabel if not set.
  label      String?
  // Session buckets only, from the Slots tab's Capacity column. Refreshed on
  // every sync where a match is found; left untouched otherwise, so a manual
  // override or a prior sync's value survives a gap in the Slots tab.
  capacity   Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  exam Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  rows SignupRow[]

  @@unique([examId, kind, naturalKey])
  @@index([examId, kind])
}

// One student's current signup state for one exam. Upserted by (examId,
// studentId): a re-sync overwrites this in place, so "which bucket is this
// student in right now" is always a single row, never a history to reduce.
// Every non-dropped roster student gets exactly one of these after any sync —
// a student absent from the sheet entirely is pointed at the not_signed_up
// bucket the same as one whose row literally says "Not signed up".
model SignupRow {
  id            String   @id @default(cuid())
  examId        String
  studentId     String
  bucketId      String
  rawSignupSlot String // exact SignupSlot cell text, kept for the dashboard tooltip
  // "gtId" | "canvasUserId" — which identifier matched, so a mismatch is
  // diagnosable. Null means no sheet row matched this student at all.
  matchedOn     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bucket  SignupBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([bucketId])
}

// ---------------------------------------------------------------------- run side

model GenerationRun {
  id             String    @id @default(cuid())
  examId         String
  label          String?
  seedUsed       String // snapshot of exam.instructorSeed at run time
  identityField  String    @default("gtId") // snapshot of exam.identityField
  sections       String    @default("[]") // JSON array; empty means all sections
  status         String    @default("pending") // pending | running | completed | failed
  error          String?
  studentCount   Int       @default(0)
  completedCount Int       @default(0)
  outputDir      String    @default("")
  // Cover-page content snapshotted so a renamed course/exam never rewrites history.
  examTitle      String    @default("")
  courseName     String    @default("")
  instructions   String?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?
  createdById    String?
  inputChecksum  String?
  configuration  String    @default("{}")
  lockedAt       DateTime?

  exam         Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions    RunQuestion[]
  studentExams StudentExam[]
  imports      GradingImport[]

  @@index([examId])
}

model RunQuestion {
  id               String  @id @default(cuid())
  runId            String
  sourceQuestionId String
  order            Int
  title            String?
  points           Float

  run        GenerationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  variations RunVariation[]

  @@index([runId, order])
}

model RunVariation {
  id                String @id @default(cuid())
  runQuestionId     String
  sourceVariationId String
  order             Int
  label             String
  promptMarkdown    String
  // Markdown is rendered once per run rather than once per student: 36 prompts
  // instead of ~4,800 renders for a 404-student, 12-question exam.
  promptHtml        String

  runQuestion RunQuestion @relation(fields: [runQuestionId], references: [id], onDelete: Cascade)
  choices     RunChoice[]

  @@index([runQuestionId, order])
}

model RunChoice {
  id             String  @id @default(cuid())
  runVariationId String
  sourceChoiceId String
  order          Int
  textMarkdown   String
  textHtml       String
  isCorrect      Boolean
  pinToLast      Boolean

  runVariation RunVariation @relation(fields: [runVariationId], references: [id], onDelete: Cascade)

  @@index([runVariationId, order])
}

model StudentExam {
  id        String   @id @default(cuid())
  runId     String
  studentId String
  traceCode String
  // JSON ExamLayout: ordered [{ position, runQuestionId, runVariationId,
  // choiceOrder: [runChoiceId...], correctLetter, choiceCount, points }].
  // This is the authoritative answer key — grading is a pure lookup against it.
  layout    String
  pdfPath   String?
  pageCount Int?
  createdAt DateTime @default(now())

  run       GenerationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  results   StudentResult[]
  overrides Override[]

  @@unique([runId, studentId])
  @@index([runId])
}

// ------------------------------------------------------------------ grading side

model GradingImport {
  id           String    @id @default(cuid())
  runId        String
  filename     String
  matched      Int       @default(0)
  // JSON: { csvOnly: [{id,name}], rosterOnly: [{id,name}], missingStatus: n }
  unmatched    String    @default("{}")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  uploadedById String?
  sha256       String?
  storagePath  String?
  archivedAt   DateTime?

  run     GenerationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  results StudentResult[]

  @@index([runId])
}

model StudentResult {
  id            String @id @default(cuid())
  importId      String
  studentExamId String
  status        String // graded | not_taken | excused
  earned        Float  @default(0)
  possible      Float  @default(0)

  import      GradingImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  studentExam StudentExam      @relation(fields: [studentExamId], references: [id], onDelete: Cascade)
  questions   QuestionResult[]

  @@unique([importId, studentExamId])
  @@index([importId])
}

model QuestionResult {
  id          String @id @default(cuid())
  resultId    String
  position    Int
  rawResponse String
  letters     String @default("[]") // JSON array of parsed letters
  verdict     String // correct | incorrect | blank | multi | out_of_range
  awarded     Float
  possible    Float

  result StudentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId, position])
}

// Keyed to StudentExam rather than to an import, so a manual override survives
// re-importing a corrected Gradescope CSV.
model Override {
  id            String   @id @default(cuid())
  studentExamId String
  position      Int
  awarded       Float
  note          String?
  createdAt     DateTime @default(now())
  createdById   String?

  studentExam StudentExam @relation(fields: [studentExamId], references: [id], onDelete: Cascade)

  @@unique([studentExamId, position])
}

model AuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  courseId      String?
  metadata      String   @default("{}")
  correlationId String?
  createdAt     DateTime @default(now())

  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}
