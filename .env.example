DATABASE_URL="file:./dev.db"

# One-time local bootstrap. Used only if the database contains no users; remove or
# rotate after creating the first OWNER. Local auth is not Georgia Tech CAS/Duo.
TWISTER_BOOTSTRAP_OWNER_EMAIL="you@gatech.edu"
TWISTER_BOOTSTRAP_OWNER_PASSWORD="replace-with-a-long-unique-password"

# Signs the session cookie. Any long random string.
TWISTER_SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Where generated exam PDFs are written.
TWISTER_OUTPUT_DIR="./output"

# Private local development storage for imported files (never commit its contents).
TWISTER_PRIVATE_STORAGE_DIR="./private-storage"
