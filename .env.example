DATABASE_URL="file:./dev.db"

# Instructor login. Set TWISTER_ADMIN_PASSWORD to whatever you want, then restart.
TWISTER_ADMIN_EMAIL="you@gatech.edu"
TWISTER_ADMIN_PASSWORD="set-a-password"

# Signs the session cookie. Any long random string.
TWISTER_SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Where generated exam PDFs are written.
TWISTER_OUTPUT_DIR="./output"

# Canvas LMS. Leave blank to use CSV import/export only.
# The token is a personal access token from Canvas > Account > Settings. It carries
# your full Canvas permissions and cannot be scoped, so it stays server-side only.
CANVAS_BASE_URL="https://gatech.instructure.com"
CANVAS_TOKEN=""
