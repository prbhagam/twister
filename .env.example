DATABASE_URL="file:./dev.db"

# Instructor login. Set the password locally; it is stored as a secure hash in the
# database after the first sign-in. Local auth is not Georgia Tech CAS/Duo.
TWISTER_ADMIN_EMAIL="you@gatech.edu"
TWISTER_ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Signs the session cookie. Any long random string.
TWISTER_SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Where generated exam PDFs are written.
TWISTER_OUTPUT_DIR="./output"

# Private local development storage for imported files (never commit its contents).
TWISTER_PRIVATE_STORAGE_DIR="./private-storage"

# Canvas API token; keep this server-only and never commit it. Create a token in
# Canvas Account → Settings → New Access Token, with access to the required courses.
CANVAS_API_TOKEN="replace-with-a-canvas-access-token"
CANVAS_BASE_URL="https://gatech.instructure.com"
